# Data — never commit (licenses + size); loaders re-fetch by pinned version + hash (PLAN §10)
/data/
# Tables/figures are regenerated deterministically via `make`.
/results/**/*.jsonl

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets
.env
*.key

# OS / editor
.DS_Store
.ipynb_checkpoints/
.specstory/

# AI editor / agent context
.cursor/
.cursorrules
.cursorindexingignore
docs/claude/

# Keep these tracked:
!.gitignore
!.python-version
