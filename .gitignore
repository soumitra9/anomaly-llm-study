# Data — never commit (licenses + size); loaders re-fetch by pinned version + hash (PLAN §10)
/data/
# Tables/figures are regenerated deterministically via `make`.
/results/**/*.jsonl

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets
.env
*.key

# OS / editor
.DS_Store
.ipynb_checkpoints/
.specstory/
.vscode/settings.json

# Third-party vendored code (local only)
third_party/AnoLLM

# AI editor / agent context
.cursor/
.cursorrules
.cursorindexingignore
docs/claude/

# Paper drafts — TEMP tracked for revision resubmit (~2026-08-09); restore `paper/` line after
# paper/
paper/**/.DS_Store
paper/**/*.aux
paper/**/*.log
paper/**/*.blg

# Experiment results — TEMP tracked for revision resubmit (~2026-08-09); restore `results/` line after
# results/
results/logs/
results/**/.DS_Store

# Keep these tracked:
!.gitignore
!.python-version
